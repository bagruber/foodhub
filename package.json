{
  "name": "foodhub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hostinger": "tsc -b && vite build --base=/data/foodhub/",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data": "python etl/bundle.py moosburg",
    "check": "python etl/check.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "maplibre-gl": "^6.15.0",
    "moosburg-design": "github:bagruber/moosburg-design#v0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
